# Database Configuration
# Default is sqlite:///./sdlc_studio.db if not provided
DATABASE_URL=sqlite:///./sdlc_studio.db

# LLM Providers Configuration (Provide at least one)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Default LLM configurations
DEFAULT_LLM_PROVIDER=gemini  # options: openai, gemini, anthropic
DEFAULT_LLM_MODEL=gemini-2.5-flash # or gemini-1.5-pro, gpt-4o, claude-3-5-sonnet

# Authentication Key
STUDIO_API_KEY=default_secret_key_12345

